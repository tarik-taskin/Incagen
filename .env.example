# Local-only build. All four emulators must be running. No cloud fallback.
VITE_FIREBASE_MODE=emulator
VITE_FIREBASE_PROJECT_ID=demo-incagen

# Netlify/cloud builds use VITE_FIREBASE_MODE=cloud and the public Firebase Web App config.
# VITE_AUTH_ONLY_PREVIEW=true
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
