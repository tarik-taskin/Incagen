# `npm run dev` loads these values from the ignored `.env.cloud-preview.local` file.
# Copy the public Firebase Web App config from the Netlify site's environment.
VITE_FIREBASE_MODE=cloud
VITE_AUTH_ONLY_PREVIEW=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# `npm run dev:emulator` and `npm run dev:web` use the tracked `.env.emulator`.
