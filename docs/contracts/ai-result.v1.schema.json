{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "analysisId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "summary": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidence": {
            "minItems": 1,
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "chunkId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "locator": {
                  "type": "object",
                  "properties": {
                    "page": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "sheet": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "slide": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "section": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "rowStart": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "rowEnd": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "sourceId",
                "sha256",
                "chunkId",
                "locator"
              ],
              "additionalProperties": false
            }
          },
          "metricIds": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "required": [
          "text",
          "evidence",
          "metricIds"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "observation",
              "interpretation"
            ]
          },
          "statements": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "evidence": {
                  "minItems": 1,
                  "maxItems": 256,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "sourceId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "chunkId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "locator": {
                        "type": "object",
                        "properties": {
                          "page": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "sheet": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "slide": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "section": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "rowStart": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "rowEnd": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "sourceId",
                      "sha256",
                      "chunkId",
                      "locator"
                    ],
                    "additionalProperties": false
                  }
                },
                "metricIds": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              },
              "required": [
                "text",
                "evidence",
                "metricIds"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "statements"
        ],
        "additionalProperties": false
      }
    },
    "recommendations": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "basisFindingIds": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "required": [
          "id",
          "action",
          "basisFindingIds"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "evidence": {
                "minItems": 1,
                "maxItems": 256,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sourceId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "chunkId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "locator": {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "sheet": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "slide": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "section": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "rowStart": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "rowEnd": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "sourceId",
                    "sha256",
                    "chunkId",
                    "locator"
                  ],
                  "additionalProperties": false
                }
              },
              "status": {
                "type": "string",
                "const": "available"
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "label",
              "unit",
              "method",
              "evidence",
              "status",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "evidence": {
                "minItems": 1,
                "maxItems": 256,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sourceId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "chunkId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "locator": {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "sheet": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "slide": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "section": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "rowStart": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "rowEnd": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "sourceId",
                    "sha256",
                    "chunkId",
                    "locator"
                  ],
                  "additionalProperties": false
                }
              },
              "status": {
                "type": "string",
                "const": "unavailable"
              },
              "value": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "id",
              "label",
              "unit",
              "method",
              "evidence",
              "status",
              "value",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "datasets": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "points": {
            "minItems": 1,
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "metricId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "label",
                "metricId",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label",
          "unit",
          "points"
        ],
        "additionalProperties": false
      }
    },
    "charts": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "enum": [
              "bar",
              "horizontal-bar",
              "line",
              "donut"
            ]
          },
          "datasetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "datasetId"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    }
  },
  "required": [
    "schemaVersion",
    "analysisId",
    "objective",
    "summary",
    "findings",
    "recommendations",
    "metrics",
    "datasets",
    "charts",
    "limitations"
  ],
  "additionalProperties": false
}
