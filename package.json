{
  "name": "incagen",
  "private": true,
  "overrides": { "gaxios": { "uuid": "^11.1.1" }, "express": { "qs": "^6.16.0" } },
  "engines": { "node": "^22.19.0 || ^24.0.0" },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "build:functions": "npm --prefix functions run build",
    "emulators": "npm run build:functions && firebase emulators:start --project demo-incagen --only auth,firestore,storage,functions",
    "test:integration": "npm run build:functions && firebase emulators:exec --project demo-incagen --only auth,firestore,storage,functions \"node --test integration/*.test.mjs\"",
    "test:local": "npm run build:functions && firebase emulators:exec --project demo-incagen --only auth,firestore,storage,functions \"npm run test:e2e\""
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.40.0",
    "papaparse": "^5.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "firebase-tools": "^15.30.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.27",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.5",
    "vitest": "^5.0.0"
  }
}
